---
const cantidad = 5;
const columnas = Array.from({ length: cantidad });

import RandonButton from "../components/RandonButton.astro";
import ShortCuts from "../components/ShortCuts.astro";
import ColorPicker from "../components/ColorPicker.astro";
---

<div class="main_container">
  <div class="column_colors">
    {
      columnas.map(() => (
        <div class="color">
          <ShortCuts />
          <div class="color-text-cont">
            <ColorPicker />
            <p class="color_code" />
            <div class="badge">Change color</div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="controls">
    <RandonButton />
  </div>
</div>

<style lang="scss">
  @use "../styles/mixins" as *;

  .main_container {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
  }

  .column_colors {
    width: 100%;
    height: 100%;
    display: flex;
  }

  .color {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: end;
    gap: 10px;
  }

  .color-text-cont {
    position: relative;
    @include flex-center;
  }

  .badge {
    opacity: 0;
    position: absolute;
    width: max-content;
    top: -20px;
    background-color: #1a1a18;
    color: white;
    padding: 10px 15px;
    border-radius: 10px;
    transition: ease-in-out 0.2s;
  }

  .color_code {
    font-size: 35px;
    margin-bottom: 90px;
    cursor: pointer;
    padding: 10px;
  }

  .color_code:hover {
    background-color: #1a1a1838;
    border-radius: 10px;
  }

  .color_code:hover + .badge {
    opacity: 1;
  }

  .controls {
    padding: 10px 30px;
    display: flex;
    gap: 10px;
    display: none;
  }

  @media screen and (max-width: 768px) {
    .column_colors {
      width: 100%;
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .color {
      background-color: #123abc;
      flex: 1;
      min-height: 0;
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      justify-content: space-between;
      padding: 30px;
    }

    .color-text-cont {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .color-icons {
      display: block;
    }

    .color_code {
      font-size: 25px;
      padding: 0;
      margin: 0;
    }

    .badge {
      display: none;
    }

    .controls {
      padding: 10px;
      display: flex;
      gap: 10px;
      display: block;
    }

    .icon-badge {
      position: absolute;
      width: max-content;
      top: -50px;
      opacity: 0;
      transition: ease-in 0.2s;
      background-color: #1b2021;
      padding: 8px 14px;
      border-radius: 8px;
      color: #fff;
      pointer-events: none;
      display: none;
    }
  }
</style>
