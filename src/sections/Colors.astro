---
const cantidad = 5;
const columnas = Array.from({ length: cantidad });

import RandonButton from "../components/RandonButton.astro";
import IconCopy from "../icons/IconCopy.astro";
---

<div class="main_container">
  <div class="column_colors">
    {
      columnas.map(() => (
        <div class="color">
          <div class="color-icons">
            <span class="color-copy">
              <IconCopy class="icon-color" size={24} />
            </span>
          </div>
          <p class="color_code" />
        </div>
      ))
    }
  </div>
  <div class="controls">
    <RandonButton />
  </div>
</div>

<style lang="scss">
  .main_container {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    width: 100%;
  }

  .column_colors {
    width: 100%;
    height: 100%;
    display: flex;
  }

  .color {
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: end;
    gap: 10px;
  }

  .color-icons {
    display: none;
  }

  .color:hover .color-icons {
    display: block;
    cursor: pointer;
  }

  .icon-color {
    cursor: pointer;
  }

  .color_code {
    font-size: 35px;
    padding-bottom: 90px;
  }

  .controls {
    padding: 10px 30px;
    display: flex;
    gap: 10px;
    display: none;
  }

  @media screen and (max-width: 768px) {
    .column_colors {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    .color {
      background-color: #123abc;
      flex: 1;
      height: 100%;
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      justify-content: space-between;
      padding: 30px;
    }

    .color-icons {
      display: block;
    }

    .color_code {
      font-size: 25px;
      padding: 0;
    }

    .controls {
      padding: 10px;
      display: flex;
      gap: 10px;
      display: block;
    }
  }
</style>
