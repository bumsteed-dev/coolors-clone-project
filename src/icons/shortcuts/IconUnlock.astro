---
interface Props {
  size?: string | number;
  class?: string;
}

const { size = "1em", class: className } = Astro.props;
const base = typeof size === "number" ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  class={className}
  style={`width: var(--icon-size, ${base}); height: var(--icon-size, ${base});`}
>
  <path d="M0 0h48v48H0z" fill="none"></path>
  <g fill="none" stroke="currentColor" stroke-linejoin="round" stroke-width="4">
    <rect width="34" height="22" x="7" y="22.048" rx="2"></rect>
    <path
      stroke-linecap="round"
      d="M14 22v-7.995c-.005-5.135 3.923-9.438 9.086-9.954S32.967 6.974 34 12.006M24 30v6"
    ></path>
  </g>
</svg>
