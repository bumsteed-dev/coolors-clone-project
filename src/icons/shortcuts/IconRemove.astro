---
interface Props {
  size?: string | number;
  class?: string;
}

const { size = "1em", class: className } = Astro.props;
const base = typeof size === "number" ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  style={`width: var(--icon-size, ${base}); height: var(--icon-size, ${base});`}
>
  <path d="M18 6 6 18"></path>
  <path d="M6 6l12 12"></path>
</svg>
