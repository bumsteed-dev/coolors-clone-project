---
interface Props {
  size?: string | number;
  class?: string;
}

const { size = "1em", class: className } = Astro.props;
const base = typeof size === "number" ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  style={`width: var(--icon-size, ${base}); height: var(--icon-size, ${base});`}
>
  <path d="M0 0h24v24H0z" fill="none"></path>
  <g fill="currentColor" fill-rule="evenodd" clip-rule="evenodd">
    <path
      d="M5.47 5.47a.75.75 0 0 1 1.06 0l12 12a.75.75 0 1 1-1.06 1.06l-12-12a.75.75 0 0 1 0-1.06"
    ></path>
    <path
      d="M18.53 5.47a.75.75 0 0 1 0 1.06l-12 12a.75.75 0 0 1-1.06-1.06l12-12a.75.75 0 0 1 1.06 0"
    ></path>
  </g>
</svg>
