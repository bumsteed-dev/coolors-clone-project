---
interface Props {
  size?: string | number;
  class?: string;
}

const { size = "1em", class: className } = Astro.props;
const base = typeof size === "number" ? `${size}px` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 21 21"
  class={className}
  style={`width: var(--icon-size, ${base}); height: var(--icon-size, ${base});`}
>
  <path d="M0 0h21v21H0z" fill="none"></path>
  <g
    fill="none"
    fill-rule="evenodd"
    stroke="currentColor"
    stroke-linecap="round"
    stroke-linejoin="round"
    transform="translate(2 2)"
  >
    <circle cx="8.5" cy="8.5" r="8"></circle>
    <path d="m8.527.5l-.027 16"></path>
  </g>
</svg>
