---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  robots?: string;
}

const {
  title = "Colorya — Educational Color Palette Generator",
  description = "An educational project inspired by Coolors, built to practice JavaScript and DOM manipulation.",
  image = "/og-image.jpg",
  type = "website",
  robots = "index, follow",
} = Astro.props;

const site = "https://colorya.bumsteed.site";
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;
const fullTitle = title.includes("Colorya") ? title : `${title} | Colorya`;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={description} />
<meta property="og:locale" content="en" />
<meta property="og:site_name" content="Colorya" />

<!-- Twitter/X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={description} />
