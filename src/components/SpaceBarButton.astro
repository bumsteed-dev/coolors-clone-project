---
import { IconSpaceBar } from "../icons";
---

<button class="btn-space"
  >Space
  <IconSpaceBar />
</button>

<style>
  .btn-space {
    color: #2a2a2a;
    background-color: #f9f9f9;
    border: none;
    font-size: 18px;
    display: flex;
    padding: 7px 20px;
    max-width: max-content;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 8px;
    box-shadow:
      rgba(0, 0, 0, 0.05) 0px 6px 24px 0px,
      rgba(0, 0, 0, 0.08) 0px 0px 0px 1px;
  }
</style>
