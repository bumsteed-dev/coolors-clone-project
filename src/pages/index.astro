---
import Analytics from "@vercel/analytics/astro";
import CopyCipboardReady from "../components/CopyCipboardReady.astro";
import Header from "../sections/Header.astro";
import Colors from "../sections/Colors.astro";
import Tools from "../sections/Tools.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=Urbanist:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <title>Colorya — Coolors Clone Project (práctica de JS/DOM)</title>
  </head>
  <body id="body" class="body">
    <CopyCipboardReady />
    <Header />
    <Tools />
    <Colors />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Inter Tight", sans-serif;
      }

      body {
        height: 100vh;
        width: 100%;
        border-radius: 20px;
        position: relative;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      @media screen and (max-width: 768px) {
        body {
          height: 100dvh;
          overflow-x: hidden;
          overflow-y: hidden;
        }
      }
    </style>
    <script is:inline src="/app.js"></script>
    <Analytics />
  </body>
</html>
