---
import Analytics from "@vercel/analytics/astro";
import RandonButton from "../components/RandonButton.astro";
import SpaceBarButton from "../components/SpaceBarButton.astro";
const cantidad = 5;
const columnas = Array.from({ length: cantidad });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rethink+Sans:ital,wght@0,400..800;1,400..800&display=swap"
      rel="stylesheet"
    />
    <title>Colorya — Coolors Clone Project (práctica de JS/DOM)</title>
  </head>
  <body id="body" class="body">
    <div class="main_container">
      <div class="controls">
        <RandonButton />
        <SpaceBarButton />
      </div>
      <div class="column_colors">
        {
          columnas.map(() => (
            <div class="color">
              <p class="color_code" />
            </div>
          ))
        }
      </div>
    </div>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Rethink Sans", sans-serif;
      }

      body {
        height: 100vh;
        width: 100%;
        border-radius: 20px;
      }

      .main_container {
        display: flex;
        flex-direction: column;
        height: 100%;
        width: 100%;
      }

      .column_colors {
        width: 100%;
        height: 100%;
        display: flex;
      }

      .color {
        flex: 1;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .color_code {
        font-size: 40px;
      }

      .controls {
        padding: 10px 30px;
        display: flex;
        gap: 10px;
      }

      @media screen and (max-width: 768px) {

        body {
          height: 100dvh;
          overflow-x: hidden;
          overflow-y: hidden;
        }

        .column_colors {
          width: 100%;
          height: 100%;
          display: flex;
          flex-direction: column;
        }

        .color {
          background-color: #123abc;
          flex: 1;
          height: 100%;
          margin: 5px;
          border-radius: 10px;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .color_code {
          font-size: 30px;
        }
      }
    </style>
    <script is:inline src="/app.js"></script>
    <Analytics />
  </body>
</html>
